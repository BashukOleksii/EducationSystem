<UserControl
    x:Class="EducationSystem.Views.LearningDynamicsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок і стан -->
        <StackPanel Grid.Row="0">
            <TextBlock
                Text="Динаміка навчального процесу"
                FontSize="23"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Аналітичний звіт, сформований RDLC Report Designer"
                Foreground="#667085"
                Margin="0,4,0,8"/>

            <TextBlock
                Text="{Binding Message}"
                Foreground="#475467"
                Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Фільтри та експорт -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">

            <StackPanel Width="150" Margin="0,0,10,0">
                <TextBlock Text="Дата від"/>
                <DatePicker
                    SelectedDate="{Binding FromDate, Mode=TwoWay}"
                    Height="30"/>
            </StackPanel>

            <StackPanel Width="150" Margin="0,0,10,0">
                <TextBlock Text="Дата до"/>
                <DatePicker
                    SelectedDate="{Binding ToDate, Mode=TwoWay}"
                    Height="30"/>
            </StackPanel>

            <Button Content="Показати"
                    Command="{Binding LoadCommand}"
                    Width="85"
                    Height="30"
                    Margin="0,17,8,0"/>

            <Button Content="Очистити"
                    Command="{Binding ClearFiltersCommand}"
                    Width="85"
                    Height="30"
                    Margin="0,17,8,0"/>

            <Button Content="PDF"
                    Click="ExportPdf_Click"
                    Width="70"
                    Height="30"
                    Margin="0,17,8,0"/>

            <Button Content="Excel"
                    Click="ExportExcel_Click"
                    Width="70"
                    Height="30"
                    Margin="0,17,0,0"/>

        </WrapPanel>

        <!-- Вбудований WinForms ReportViewer -->
        <Border Grid.Row="2"
                BorderBrush="#D0D5DD"
                BorderThickness="1">

            <wfi:WindowsFormsHost x:Name="ReportHost"/>

        </Border>
    </Grid>
</UserControl>
