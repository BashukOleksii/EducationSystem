<Window x:Class="EducationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EducationSystem"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#F5F7FA"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,8,0,24">
                    <TextBlock Text="EducationSystem"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#17253D"
                               Margin="4,0,0,20"/>
                    <TextBlock x:Name="CurrentUserText"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="#334155"
                               Margin="4,0,0,5"/>
                    <TextBlock x:Name="CurrentRoleText"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="4,0,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavigationPanel">
                        <Button x:Name="GroupsButton" Content="Групи"
                                Height="42" Margin="0,0,0,8"
                                Click="GroupsButton_Click"/>
                        <Button x:Name="SubjectsButton" Content="Предмети"
                                Height="42" Margin="0,0,0,8"
                                Click="SubjectsButton_Click"/>
                        <Button x:Name="TeachersButton" Content="Викладачі"
                                Height="42" Margin="0,0,0,8"
                                Click="TeachersButton_Click"/>
                        <Button x:Name="StudentsButton" Content="Студенти"
                                Height="42" Margin="0,0,0,8"
                                Click="StudentsButton_Click"/>
                        <Button x:Name="TeacherSubjectsButton" Content="Викладачі та предмети"
                                Height="42" Margin="0,0,0,8"
                                Click="TeacherSubjectsButton_Click"/>
                        <Button x:Name="LessonsButton" Content="Заняття"
                                Height="42" Margin="0,0,0,8"
                                Click="LessonsButton_Click"/>
                        <Button x:Name="JournalButton" Content="Журнал"
                                Height="42" Margin="0,0,0,8"
                                Click="JournalButton_Click"/>
                        <Button x:Name="AnalyticsButton" Content="Аналітика"
                                Height="42" Margin="0,0,0,8"
                                Click="AnalyticsButton_Click"/>
                        <Button x:Name="UsersButton" Content="Користувачі"
                                Height="42" Margin="0,0,0,8"
                                Click="UsersButton_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="LogoutButton"
                        Grid.Row="2"
                        Content="Вийти з акаунта"
                        Height="42"
                        Margin="0,16,0,8"
                        Background="#FEE2E2"
                        Foreground="#991B1B"
                        BorderBrush="#FECACA"
                        Cursor="Hand"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Column="1"/>
    </Grid>
</Window>
