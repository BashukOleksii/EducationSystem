<UserControl x:Class="EducationSystem.Views.TeachersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="975">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Заголовок -->

        <TextBlock
            Grid.Row="0"
            Text="Викладачі"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,0,0,20"/>


        <!-- Пошук та фільтри -->

        <Grid
            Grid.Row="1"
            Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- Пошук -->

            <TextBox
                Grid.Column="0"
                Height="36"
                Margin="0,0,12,0"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText,
                               UpdateSourceTrigger=PropertyChanged}"/>


            <!-- Увімкнення фільтра -->

            <CheckBox
                Grid.Column="1"
                Content="Категорія"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                IsChecked="{Binding IsCategoryFilterEnabled}"/>


            <!-- Категорія -->

            <ComboBox
                Grid.Column="2"
                Height="36"
                Margin="0,0,12,0"
                VerticalContentAlignment="Center"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding FilterCategory}"
                IsEnabled="{Binding IsCategoryFilterEnabled}"/>


            <Button
                Grid.Column="3"
                Content="Пошук"
                Width="100"
                Margin="0,0,8,0"
                Command="{Binding SearchCommand}"/>


            <Button
                Grid.Column="4"
                Content="Очистити"
                Width="100"
                Command="{Binding ClearSearchCommand}"/>

        </Grid>


        <!-- Основна область -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>


            <!-- Таблиця -->

            <DataGrid
                Grid.Column="0"
                ItemsSource="{Binding Teachers}"
                SelectedItem="{Binding SelectedTeacher}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding Id}"
                        Width="55"/>


                    <DataGridTextColumn
                        Header="Прізвище"
                        Binding="{Binding LastName}"
                        Width="*"/>


                    <DataGridTextColumn
                        Header="Ім'я"
                        Binding="{Binding FirstName}"
                        Width="*"/>


                    <DataGridTextColumn
                        Header="Email"
                        Binding="{Binding Email}"
                        Width="1.5*"/>


                    <DataGridTextColumn
                        Header="Категорія"
                        Binding="{Binding Category}"
                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>


            <!-- Форма -->

            <Border
                Grid.Column="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock
                            Text="Викладач"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,0,0,20"/>


                        <!-- Ім'я -->

                        <TextBlock
                            Text="Ім'я"
                            Margin="0,0,0,4"/>

                        <TextBox
                            Height="34"
                            Margin="0,0,0,14"
                            VerticalContentAlignment="Center"
                            Text="{Binding FirstName,
                                           UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- Прізвище -->

                        <TextBlock
                            Text="Прізвище"
                            Margin="0,0,0,4"/>

                        <TextBox
                            Height="34"
                            Margin="0,0,0,14"
                            VerticalContentAlignment="Center"
                            Text="{Binding LastName,
                                           UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- Email -->

                        <TextBlock
                            Text="Email"
                            Margin="0,0,0,4"/>

                        <TextBox
                            Height="34"
                            Margin="0,0,0,14"
                            VerticalContentAlignment="Center"
                            Text="{Binding Email,
                                           UpdateSourceTrigger=PropertyChanged}"/>


                        <!-- Категорія -->

                        <TextBlock
                            Text="Категорія"
                            Margin="0,0,0,4"/>

                        <ComboBox
                            Height="34"
                            Margin="0,0,0,20"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"/>


                        <!-- CRUD -->

                        <Button
                            Content="Зберегти"
                            Height="36"
                            Margin="0,0,0,8"
                            Command="{Binding SaveCommand}"/>


                        <Button
                            Content="Очистити"
                            Height="36"
                            Margin="0,0,0,8"
                            Command="{Binding NewCommand}"/>


                        <Button
                            Content="Видалити"
                            Height="36"
                            Command="{Binding DeleteCommand}"/>


                        <!-- Повідомлення -->

                        <TextBlock
                            Text="{Binding Message}"
                            TextWrapping="Wrap"
                            Margin="0,20,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- Пагінація -->

        <Grid
            Grid.Row="3"
            Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center">

                <Run Text="Усього записів: "/>

                <Run Text="{Binding TotalCount}"/>

            </TextBlock>


            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">

                <Button
                    Content="←"
                    Width="40"
                    Height="32"
                    Command="{Binding PreviousPageCommand}"/>


                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center">

                    <Run Text="Сторінка "/>

                    <Run Text="{Binding CurrentPage}"/>

                    <Run Text=" з "/>

                    <Run Text="{Binding TotalPages}"/>

                </TextBlock>


                <Button
                    Content="→"
                    Width="40"
                    Height="32"
                    Command="{Binding NextPageCommand}"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>