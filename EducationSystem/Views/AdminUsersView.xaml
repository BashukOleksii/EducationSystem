<UserControl x:Class="EducationSystem.Views.AdminUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="640" Background="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <Button x:Name="RefreshButton" Content="Оновити" Width="110" Height="36"
                    DockPanel.Dock="Right" Click="RefreshButton_Click"/>
            <StackPanel>
                <TextBlock Text="Керування обліковими записами" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="SQL Login і Database User створюються одночасно; дозволені тільки es_*"
                           Foreground="#64748B" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="270"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="UsersGrid" Grid.Column="0" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" SelectionChanged="UsersGrid_SelectionChanged"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логін" Binding="{Binding LoginName}" Width="1.2*"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="*"/>
                    <DataGridTextColumn Header="Викладач" Binding="{Binding TeacherFullName}" Width="1.4*"/>
                    <DataGridTextColumn Header="Стан" Binding="{Binding StatusName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#E2E8F0"
                    CornerRadius="8" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditPanel">
                        <TextBlock Text="Обліковий запис" FontWeight="SemiBold" FontSize="19"
                                   Margin="0,0,0,15"/>
                        <TextBlock Text="SQL Login (новий користувач)" Margin="0,0,0,5"/>
                        <TextBox x:Name="LoginInput" Height="34" Margin="0,0,0,13"
                                 VerticalContentAlignment="Center" Text="es_"/>
                        <TextBlock Text="Роль" Margin="0,0,0,5"/>
                        <ComboBox x:Name="RolePicker" Height="34" SelectedIndex="0"
                                  SelectionChanged="RolePicker_SelectionChanged"
                                  Margin="0,0,0,13">
                            <ComboBoxItem Content="Викладач"/>
                            <ComboBoxItem Content="Адміністрація"/>
                        </ComboBox>
                        <TextBlock Text="Прив'язка до викладача" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TeacherPicker" Height="34" Margin="0,0,0,13"
                                  DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        <TextBlock Text="Пароль (для створення / скидання)" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordInput" Height="34" Margin="0,0,0,5"/>
                        <TextBlock Text="Мінімум 12 символів; застосовується політика паролів SQL Server."
                                   FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>
                        <Button Content="Новий запис / Очистити форму" Click="NewButton_Click"
                                Height="34" Margin="0,0,0,9"/>
                        <Button Content="Створити SQL-користувача" Click="CreateButton_Click"
                                Height="36" Margin="0,0,0,9"/>
                        <Separator Margin="0,8,0,14"/>
                        <TextBlock x:Name="SelectedInfo" Text="Оберіть запис у таблиці для редагування."
                                   TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#334155"/>
                        <Button Content="Змінити роль / викладача" Click="ChangeAssignmentButton_Click"
                                Height="36" Margin="0,0,0,9"/>
                        <Button x:Name="ToggleActiveButton" Content="Заблокувати / розблокувати"
                                Click="ToggleActiveButton_Click" Height="36" Margin="0,0,0,9"/>
                        <Button Content="Скинути пароль" Click="ResetPasswordButton_Click"
                                Height="36" Margin="0,0,0,9"/>
                        <Button Content="Видалити SQL-користувача назавжди" Click="DeleteButton_Click"
                                Height="36" Background="#FEE2E2" Foreground="#991B1B"
                                BorderBrush="#FECACA"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,14,0,0"
                   TextWrapping="Wrap" Foreground="#334155" FontSize="13"/>
    </Grid>
</UserControl>
