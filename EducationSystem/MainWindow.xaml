<Window x:Class="EducationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Education System"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border
            Grid.Column="0"
            Background="#F5F5F5"
            BorderBrush="#DDDDDD"
            BorderThickness="0,0,1,0">

            <StackPanel Margin="16">

                <TextBlock
                    Text="Education System"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="8,8,8,24"/>

                <Button
    Content="Групи"
    Height="42"
    Margin="0,0,0,8"
    Click="GroupsButton_Click"/>

                <Button
    Content="Предмети"
    Height="42"
    Margin="0,0,0,8"
    Click="SubjectsButton_Click"/>

                <Button
    Content="Викладачі"
    Height="42"
    Margin="0,0,0,8"
    Click="TeachersButton_Click"/>

                <Button
    Content="Студенти"
    Height="42"
    Margin="0,0,0,8"
    Click="StudentsButton_Click"/>

                <Button
    Content="Викладачі та предмети"
    Height="42"
    Margin="0,0,0,8"
    Click="TeacherSubjectsButton_Click"/>

                <Button
    Content="Заняття"
    Height="42"
    Margin="0,0,0,8"
    IsEnabled="False"/>

                <Button
    Content="Журнал"
    Height="42"
    IsEnabled="False"/>

            </StackPanel>

        </Border>

        <!-- Content -->
        <ContentControl
            x:Name="MainContent"
            Grid.Column="1"/>

    </Grid>

</Window>