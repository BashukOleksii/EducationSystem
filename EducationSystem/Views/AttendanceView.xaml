<UserControl x:Class="EducationSystem.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Text="Відвідуваність" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Присутність, пропуски та повнота заповнення журналу"
                       Foreground="#667085" Margin="0,4,0,16"/>

            <WrapPanel Margin="0,0,0,16">
                <StackPanel Width="165" Margin="0,0,12,8">
                    <TextBlock Text="Група" Margin="0,0,0,4"/>
                    <ComboBox Height="34" ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Width="185" Margin="0,0,12,8">
                    <TextBlock Text="Предмет" Margin="0,0,0,4"/>
                    <ComboBox Height="34" ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Width="145" Margin="0,0,12,8">
                    <TextBlock Text="Від дати" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Height="34"/>
                </StackPanel>
                <StackPanel Width="145" Margin="0,0,12,8">
                    <TextBlock Text="До дати" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Height="34"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Button Content="Показати" Command="{Binding LoadCommand}"
                            Height="34" MinWidth="95" Margin="0,0,8,0"/>
                    <Button Content="Скинути" Command="{Binding ClearFiltersCommand}"
                            Height="34" MinWidth="85"/>
                </StackPanel>
            </WrapPanel>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Background="#EDF4FA" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Присутностей" Foreground="#475467"/>
                        <TextBlock Text="{Binding Report.TotalPresent}" FontSize="24" FontWeight="Bold" Foreground="#173B5E"/>
                    </StackPanel>
                </Border>
                <Border Background="#EDF4FA" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Пропусків" Foreground="#475467"/>
                        <TextBlock Text="{Binding Report.TotalMissing}" FontSize="24" FontWeight="Bold" Foreground="#173B5E"/>
                    </StackPanel>
                </Border>
                <Border Background="#EDF4FA" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Відвідуваність" Foreground="#475467"/>
                        <TextBlock Text="{Binding Report.AttendanceLabel}" FontSize="24" FontWeight="Bold" Foreground="#173B5E"/>
                    </StackPanel>
                </Border>
                <Border Background="#EDF4FA" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Заповнення журналу" Foreground="#475467"/>
                        <TextBlock Text="{Binding Report.CoverageLabel}" FontSize="24" FontWeight="Bold" Foreground="#173B5E"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <WrapPanel Margin="0,0,0,12">
                <Button Content="Експорт Excel" Click="ExportExcel_Click"
                        MinWidth="122" Height="35" Margin="0,0,10,0"/>
                <Button Content="Експорт PDF" Click="ExportPdf_Click"
                        MinWidth="115" Height="35"/>
            </WrapPanel>

            <TextBlock Text="{Binding Message}" Foreground="Firebrick" TextWrapping="Wrap"/>
            <TextBlock Text="Завантаження..." Foreground="#667085" Margin="0,5,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,12">
                <StackPanel>
                    <TextBlock Text="Відвідуваність за групами" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <scott:WpfPlot x:Name="GroupsPlot" Height="295"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Повнота заповнення журналу за місяцями"
                               FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <scott:WpfPlot x:Name="MonthsPlot" Height="295"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Деталізація" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TabControl Height="325" Margin="0,0,0,12">
                <TabItem Header="Групи">
                    <DataGrid ItemsSource="{Binding Report.Groups}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Група" Binding="{Binding GroupName}" Width="*"/>
                            <DataGridTextColumn Header="Студентів" Binding="{Binding StudentCount}" Width="95"/>
                            <DataGridTextColumn Header="Очікується" Binding="{Binding ExpectedCount}" Width="95"/>
                            <DataGridTextColumn Header="Присутніх" Binding="{Binding PresentCount}" Width="90"/>
                            <DataGridTextColumn Header="Пропусків" Binding="{Binding MissingCount}" Width="90"/>
                            <DataGridTextColumn Header="Без відмітки" Binding="{Binding UnmarkedCount}" Width="110"/>
                            <DataGridTextColumn Header="Відвідуваність, %" Binding="{Binding AttendancePercent, StringFormat={}{0:0.0}}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Студенти">
                    <DataGrid ItemsSource="{Binding Report.Students}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Група" Binding="{Binding GroupName}" Width="100"/>
                            <DataGridTextColumn Header="Студент" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Присутніх" Binding="{Binding PresentCount}" Width="90"/>
                            <DataGridTextColumn Header="Пропусків" Binding="{Binding MissingCount}" Width="90"/>
                            <DataGridTextColumn Header="Без відмітки" Binding="{Binding UnmarkedCount}" Width="110"/>
                            <DataGridTextColumn Header="Відвідуваність, %" Binding="{Binding AttendancePercent, StringFormat={}{0:0.0}}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Предмети">
                    <DataGrid ItemsSource="{Binding Report.Subjects}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="2*"/>
                            <DataGridTextColumn Header="Присутніх" Binding="{Binding PresentCount}" Width="95"/>
                            <DataGridTextColumn Header="Пропусків" Binding="{Binding MissingCount}" Width="95"/>
                            <DataGridTextColumn Header="Без відмітки" Binding="{Binding UnmarkedCount}" Width="110"/>
                            <DataGridTextColumn Header="Відвідуваність, %" Binding="{Binding AttendancePercent, StringFormat={}{0:0.0}}" Width="145"/>
                            <DataGridTextColumn Header="Заповнення, %" Binding="{Binding CoveragePercent, StringFormat={}{0:0.0}}" Width="125"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Динаміка">
                    <DataGrid ItemsSource="{Binding Report.Months}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Місяць" Binding="{Binding MonthKey}" Width="*"/>
                            <DataGridTextColumn Header="Очікується" Binding="{Binding ExpectedCount}" Width="110"/>
                            <DataGridTextColumn Header="Присутніх" Binding="{Binding PresentCount}" Width="110"/>
                            <DataGridTextColumn Header="Пропусків" Binding="{Binding MissingCount}" Width="110"/>
                            <DataGridTextColumn Header="Без відмітки" Binding="{Binding UnmarkedCount}" Width="120"/>
                            <DataGridTextColumn Header="Заповнення, %" Binding="{Binding CoveragePercent, StringFormat={}{0:0.0}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
            <TextBlock Foreground="#667085" TextWrapping="Wrap"
                       Text="Методика: відсоток відвідуваності = присутніх / (присутніх + пропуски); незаповнений журнал не є пропуском. Відсоток заповнення = внесених відміток / очікуваних відміток. Заняття підгруп виключено, оскільки в студентів немає поля підгрупи. Поточний склад груп, без історії переведень."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
