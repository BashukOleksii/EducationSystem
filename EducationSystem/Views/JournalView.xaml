<UserControl x:Class="EducationSystem.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>

            <!-- Вибір заняття -->
            <RowDefinition Height="Auto"/>

            <!-- Інформація -->
            <RowDefinition Height="Auto"/>

            <!-- Таблиця -->
            <RowDefinition Height="*"/>

            <!-- Нижня панель -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- =========================
             Заголовок
             ========================= -->

        <TextBlock
            Grid.Row="0"
            Text="Журнал"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,0,0,20"/>


        <!-- =========================
             Вибір заняття
             ========================= -->

        <Grid
            Grid.Row="1"
            Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBlock
                Grid.Column="0"
                Text="Заняття:"
                VerticalAlignment="Center"
                Margin="0,0,10,0"/>


            <ComboBox
                Grid.Column="1"
                Height="38"
                Margin="0,0,12,0"
                ItemsSource="{Binding Lessons}"
                SelectedItem="{Binding SelectedLesson}"
                DisplayMemberPath="JournalName"/>


            <Button
                Grid.Column="2"
                Content="Відкрити журнал"
                Width="150"
                Height="38"
                Command="{Binding OpenLessonCommand}"/>

        </Grid>


        <!-- =========================
             Інформація про заняття
             ========================= -->

        <Border
            Grid.Row="2"
            Background="#F5F5F5"
            Padding="14"
            CornerRadius="6"
            Margin="0,0,0,16">

            <WrapPanel>

                <TextBlock
                    Text="Група: "
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="{Binding SelectedLesson.GroupName}"
                    Margin="0,0,30,0"/>


                <TextBlock
                    Text="Предмет: "
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="{Binding SelectedLesson.SubjectName}"
                    Margin="0,0,30,0"/>


                <TextBlock
                    Text="Викладач: "
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="{Binding SelectedLesson.TeacherFullName}"
                    Margin="0,0,30,0"/>


                <TextBlock
                    Text="Дата: "
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="{Binding SelectedLesson.Date,
                                   StringFormat=dd.MM.yyyy}"/>

            </WrapPanel>

        </Border>


        <!-- =========================
             Таблиця журналу
             ========================= -->

        <DataGrid
            Grid.Row="3"

            ItemsSource="{Binding Students}"

            AutoGenerateColumns="False"
            CanUserAddRows="False"

            SelectionMode="Single"
            SelectionUnit="FullRow"

            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <DataGrid.Columns>


                <!-- Студент -->

                <DataGridTextColumn
                    Header="Студент"
                    Binding="{Binding FullName}"
                    IsReadOnly="True"
                    Width="3*"/>


                <!-- Email -->

                <DataGridTextColumn
                    Header="Email"
                    Binding="{Binding Email}"
                    IsReadOnly="True"
                    Width="3*"/>


                <!-- Оцінка -->

                <DataGridTextColumn
                    Header="Оцінка"
                    Width="1*"
                    Binding="{Binding Grade,
                                      Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"/>


                <!-- НБ -->

                <DataGridCheckBoxColumn
    Header="НБ"
    Width="1*"
    Binding="{Binding IsMissing,
                      Mode=TwoWay,
                      UpdateSourceTrigger=PropertyChanged}"/>


                <!-- Збереження одного рядка -->

                <DataGridTemplateColumn
                    Header=""
                    Width="140">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button
                                Content="Зберегти"
                                Margin="5,3"
                                Command="{Binding
                                    DataContext.SaveEntryCommand,
                                    RelativeSource={RelativeSource
                                        AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>


        <!-- =========================
             Нижня панель
             ========================= -->

        <Grid
            Grid.Row="4"
            Margin="0,16,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- Інформація -->

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center">

                <TextBlock>

                    <Run Text="Усього студентів: "/>

                    <Run Text="{Binding TotalCount}"/>

                </TextBlock>


                <TextBlock
                    Text="{Binding Message}"
                    Margin="0,5,0,0"/>

            </StackPanel>


            <!-- Зберегти всю сторінку -->

            <Button
                Grid.Column="1"
                Content="Зберегти сторінку"
                Width="170"
                Height="36"
                Margin="0,0,24,0"
                Command="{Binding SavePageCommand}"/>


            <!-- Пагінація -->

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Button
                    Content="←"
                    Width="45"
                    Height="34"
                    Command="{Binding PreviousPageCommand}"/>


                <TextBlock
                    Margin="14,0"
                    VerticalAlignment="Center">

                    <Run Text="Сторінка "/>

                    <Run Text="{Binding CurrentPage}"/>

                    <Run Text=" з "/>

                    <Run Text="{Binding TotalPages}"/>

                </TextBlock>


                <Button
                    Content="→"
                    Width="45"
                    Height="34"
                    Command="{Binding NextPageCommand}"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>