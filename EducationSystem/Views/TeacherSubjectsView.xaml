<UserControl x:Class="EducationSystem.Views.TeacherSubjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="975">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock
            Grid.Row="0"
            Text="Викладачі та предмети"
            FontSize="28"
            FontWeight="SemiBold"
            Margin="0,0,0,20"/>


        <!-- Пошук і фільтри -->

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,16">


            <!-- Пошук -->

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBox
                    Grid.Column="0"
                    Height="36"
                    Margin="0,0,8,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding SearchText,
                                   UpdateSourceTrigger=PropertyChanged}"/>


                <Button
                    Grid.Column="1"
                    Content="Пошук"
                    Width="100"
                    Margin="0,0,8,0"
                    Command="{Binding SearchCommand}"/>


                <Button
                    Grid.Column="2"
                    Content="Очистити"
                    Width="100"
                    Command="{Binding ClearSearchCommand}"/>

            </Grid>


            <!-- Фільтри -->

            <WrapPanel>

                <CheckBox
                    Content="Викладач"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsTeacherFilterEnabled}"/>


                <ComboBox
                    Width="210"
                    Height="34"
                    Margin="0,0,20,0"
                    ItemsSource="{Binding Teachers}"
                    SelectedItem="{Binding FilterTeacher}"
                    DisplayMemberPath="FullName"
                    IsEnabled="{Binding IsTeacherFilterEnabled}"/>


                <CheckBox
                    Content="Предмет"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSubjectFilterEnabled}"/>


                <ComboBox
                    Width="210"
                    Height="34"
                    ItemsSource="{Binding Subjects}"
                    SelectedItem="{Binding FilterSubject}"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsSubjectFilterEnabled}"/>

            </WrapPanel>

        </StackPanel>


        <!-- Основна область -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>


            <!-- Таблиця -->

            <DataGrid
                Grid.Column="0"
                ItemsSource="{Binding TeacherSubjects}"
                SelectedItem="{Binding SelectedTeacherSubject}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="ID"
                        Binding="{Binding Id}"
                        Width="55"/>


                    <DataGridTextColumn
                        Header="Викладач"
                        Binding="{Binding TeacherFullName}"
                        Width="*"/>


                    <DataGridTextColumn
                        Header="Предмет"
                        Binding="{Binding SubjectName}"
                        Width="*"/>


                    <DataGridTextColumn
                        Header="Підгрупа"
                        Binding="{Binding SubgroupText}"
                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>


            <!-- Форма -->

            <Border
                Grid.Column="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock
                            Text="Призначення"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Margin="0,0,0,20"/>


                        <TextBlock
                            Text="Викладач"
                            Margin="0,0,0,4"/>


                        <ComboBox
                            Height="34"
                            Margin="0,0,0,14"
                            ItemsSource="{Binding Teachers}"
                            SelectedItem="{Binding SelectedTeacher}"
                            DisplayMemberPath="FullName"/>


                        <TextBlock
                            Text="Предмет"
                            Margin="0,0,0,4"/>


                        <ComboBox
                            Height="34"
                            Margin="0,0,0,14"
                            ItemsSource="{Binding Subjects}"
                            SelectedItem="{Binding SelectedSubject}"
                            DisplayMemberPath="Name"/>


                        <CheckBox
                            Content="Вказати підгрупу"
                            Margin="0,0,0,8"
                            IsChecked="{Binding HasSubgroup}"/>


                        <TextBlock
                            Text="Номер підгрупи"
                            Margin="0,0,0,4"/>


                        <TextBox
                            Height="34"
                            Margin="0,0,0,20"
                            VerticalContentAlignment="Center"
                            IsEnabled="{Binding HasSubgroup}"
                            Text="{Binding Subgroup,
                                           UpdateSourceTrigger=PropertyChanged}"/>


                        <Button
                            Content="Зберегти"
                            Height="36"
                            Margin="0,0,0,8"
                            Command="{Binding SaveCommand}"/>


                        <Button
                            Content="Очистити"
                            Height="36"
                            Margin="0,0,0,8"
                            Command="{Binding NewCommand}"/>


                        <Button
                            Content="Видалити"
                            Height="36"
                            Command="{Binding DeleteCommand}"/>


                        <TextBlock
                            Text="{Binding Message}"
                            TextWrapping="Wrap"
                            Margin="0,20,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- Пагінація -->

        <Grid
            Grid.Row="3"
            Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center">

                <Run Text="Усього записів: "/>
                <Run Text="{Binding TotalCount}"/>

            </TextBlock>


            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">

                <Button
                    Content="←"
                    Width="40"
                    Height="32"
                    Command="{Binding PreviousPageCommand}"/>


                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center">

                    <Run Text="Сторінка "/>
                    <Run Text="{Binding CurrentPage}"/>
                    <Run Text=" з "/>
                    <Run Text="{Binding TotalPages}"/>

                </TextBlock>


                <Button
                    Content="→"
                    Width="40"
                    Height="32"
                    Command="{Binding NextPageCommand}"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>