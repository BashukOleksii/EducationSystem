<UserControl x:Class="EducationSystem.Views.GroupEnrollmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">

            <!-- Заголовок, оновлення та експорт -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Контингент студентів"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Актуальна наповненість активних академічних груп"
                               Margin="0,4,0,0"
                               Foreground="#667085"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Оновити"
                            MinWidth="95"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Click="Refresh_Click"/>
                    <Button Content="Експорт Excel"
                            MinWidth="115"
                            Height="36"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Click="ExportExcel_Click"/>
                    <Button Content="Експорт PDF"
                            MinWidth="110"
                            Height="36"
                            Padding="10,4"
                            Click="ExportPdf_Click"/>
                </StackPanel>
            </Grid>

            <!-- Ключові показники -->
            <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Margin="0,0,10,0"
                        Padding="16"
                        CornerRadius="8"
                        Background="#EDF4FA">
                    <StackPanel>
                        <TextBlock Text="Активних груп"
                                   Foreground="#475467"/>
                        <TextBlock Text="{Binding TotalGroups}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#173B5E"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,10,0"
                        Padding="16"
                        CornerRadius="8"
                        Background="#EDF4FA">
                    <StackPanel>
                        <TextBlock Text="Студентів у групах"
                                   Foreground="#475467"/>
                        <TextBlock Text="{Binding TotalStudents}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#173B5E"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        CornerRadius="8"
                        Background="#EDF4FA">
                    <StackPanel>
                        <TextBlock Text="Середня наповненість"
                                   Foreground="#475467"/>
                        <TextBlock Text="{Binding AverageGroupSize, StringFormat={}{0:N2}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#173B5E"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ScottPlot: спільна логіка побудови графіка і PDF/Excel -->
            <Border BorderThickness="1"
                    BorderBrush="#D0D5DD"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Кількість студентів за групами"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <scott:WpfPlot x:Name="GroupPlot"
                                   Height="350"/>
                </StackPanel>
            </Border>

            <!-- Таблична деталізація -->
            <TextBlock Text="Деталізація за групами"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <DataGrid ItemsSource="{Binding GroupRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      Height="265"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Група"
                                        Binding="{Binding GroupName}"
                                        Width="2*"/>
                    <DataGridTextColumn Header="Студентів"
                                        Binding="{Binding StudentCount}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Частка від загальної кількості, %"
                                        Binding="{Binding SharePercent, StringFormat={}{0:N1}}"
                                        Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Foreground="#667085"
                       TextWrapping="Wrap"
                       Text="Методика: враховуються студенти, прикріплені до активних груп. Групи без студентів також відображаються. Історія переведень між групами не враховується."/>

            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Foreground="Firebrick"
                       Margin="0,10,0,0"/>

            <TextBlock Text="Завантаження даних..."
                       Foreground="#667085"
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
